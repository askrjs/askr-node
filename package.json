{
  "name": "@askrjs/node",
  "version": "0.5.0",
  "description": "Node http adapter for @askrjs/server",
  "keywords": [
    "askr",
    "http",
    "node",
    "server"
  ],
  "homepage": "https://github.com/askrjs/askr-node#readme",
  "bugs": {
    "url": "https://github.com/askrjs/askr-node/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "askrjs",
    "url": "https://github.com/askrjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/askrjs/askr-node.git"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "docs/**/*.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "bench": "vp test bench --run",
    "bench:http": "vp test bench --run benches/http.bench.ts",
    "build": "vp pack",
    "fmt": "vp fmt .",
    "lint": "vp lint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vp test run",
    "test:publint": "publint",
    "pack:check": "node tests/package-artifacts.js",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run test:publint && npm run pack:check && npm run test:packed",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "test:coverage": "vp test run --coverage",
    "test:packed": "node tests/package-consumers.js"
  },
  "dependencies": {
    "@askrjs/auth": ">=0.5.0 <0.6.0",
    "@askrjs/server": ">=0.5.0 <0.6.0",
    "@types/ws": "^8.18.2",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@askrjs/schema": ">=0.5.0 <0.6.0",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "5.0.5",
    "publint": "^0.3.25",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0",
    "vitest": "5.0.5"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@12.0.1"
}
